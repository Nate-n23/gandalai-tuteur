# Mode démo : données fictives et réponses simulées (pour le frontend). 0 en production.
TUTEUR_DEMO=0

# Stockage
TUTEUR_BASE=/srv/gandal-ai/tuteur.sqlite3
UPLOAD_DIR=/srv/gandal-ai/depots

# Identité transmise par le backend du portail (provisoire, en attendant IAM)
TUTEUR_ENTETE_UTILISATEUR=X-Utilisateur

# Services, tous dans la VM
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=<clé de l'étape 4>
QDRANT_COLLECTION=tuteur

# Modèles : qwen3:14b sur la 3090 Ti, qwen3:8b sur la 2080 Ti, qwen3:4b en mode dégradé
LLM_MODEL=qwen3:14b
EMBED_MODEL=bge-m3
NUM_CTX=8192

# 1 = recherche par le sens ; 2 = ajoute les mots exacts et le reclassement
RAG_VERSION=1
RERANKER_PATH=/srv/modeles/bge-reranker-v2-m3

# Limites (à fixer avec l'encadrement)
MAX_UPLOAD_MB=50
MAX_COURS_PAR_ETUDIANT=10
MAX_DOCUMENTS_PAR_COURS=10
MAX_QUESTIONS_HEURE=30
MAX_CARACTERES_QUESTION=1000

# Fonctionnement sans Internet
DOCLING_ARTIFACTS_PATH=/srv/modeles/docling-models
HF_HUB_OFFLINE=1
